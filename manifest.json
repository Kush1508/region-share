{
  "manifest_version": 3,
  "name": "Region Share - Screen & Element Cropper",
  "version": "1.0.0",
  "description": "Select any DOM element or custom rectangular region and stream only that cropped view in a borderless window for Google Meet.",
  "action": {
    "default_title": "Region Share: Select Element or Drag Area to Crop"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "tabCapture",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.html",
        "viewer.js",
        "viewer.css",
        "content.css",
        "content.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
